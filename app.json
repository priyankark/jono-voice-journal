{
  "expo": {
    "name": "Interview Journal",
    "slug": "interview-journal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "interview-journal",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a2e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.journal.interviews",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "This app needs microphone access to record interview audio.",
        "NSSpeechRecognitionUsageDescription": "This app uses speech recognition to transcribe your recordings."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a1a2e"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.journal.interviews"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-av",
        {
          "microphonePermission": "Allow Interview Journal to access your microphone for recording."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Interview Journal to use the microphone for voice recording.",
          "speechRecognitionPermission": "Allow Interview Journal to use speech recognition to transcribe your recordings."
        }
      ]
    ]
  }
}
